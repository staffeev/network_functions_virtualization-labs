# VNF «межсетевой экран»: фильтрация в мосту (семейство bridge), правила без состояния.
# ${FW_PORT} (= 8000 + N) подставляется через envsubst в vnfm.sh. Запрещаем этот порт, считаем остальной трафик.
flush ruleset
table bridge vnf_fw {
  chain forward {
    type filter hook forward priority 0; policy accept;
    ip protocol tcp tcp dport ${FW_PORT} counter drop comment "block tcp/${FW_PORT}"
    ip protocol tcp tcp dport 80 counter accept comment "allow http"
    ip protocol icmp counter accept comment "allow icmp"
    counter comment "other"
  }
}
